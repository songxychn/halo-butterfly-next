diff --git a/src/main/java/run/halo/umami/PublicStatsEndpoint.java b/src/main/java/run/halo/umami/PublicStatsEndpoint.java
new file mode 100644
index 0000000..9fa1c44
--- /dev/null
+++ b/src/main/java/run/halo/umami/PublicStatsEndpoint.java
@@ -0,0 +1,46 @@
+package run.halo.umami;
+
+import java.util.Map;
+import org.springframework.http.CacheControl;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Component;
+import org.springframework.web.reactive.function.server.RouterFunction;
+import org.springframework.web.reactive.function.server.RouterFunctions;
+import org.springframework.web.reactive.function.server.ServerRequest;
+import org.springframework.web.reactive.function.server.ServerResponse;
+import org.springframework.web.server.ResponseStatusException;
+import reactor.core.publisher.Mono;
+import run.halo.app.core.extension.endpoint.CustomEndpoint;
+import run.halo.app.extension.GroupVersion;
+
+@Component
+public class PublicStatsEndpoint implements CustomEndpoint {
+    private final PublicStatsService service;
+
+    public PublicStatsEndpoint(PublicStatsService service) { this.service = service; }
+
+    @Override public RouterFunction<ServerResponse> endpoint() {
+        return RouterFunctions.route().GET("stats", this::get).build();
+    }
+
+    private Mono<ServerResponse> get(ServerRequest request) {
+        if (request.queryParams().keySet().stream().anyMatch(key -> !key.equals("path"))
+            || request.queryParams().getOrDefault("path", java.util.List.of()).size() > 1) {
+            return ServerResponse.badRequest().cacheControl(CacheControl.noStore())
+                .bodyValue(Map.of("error", "Invalid query"));
+        }
+        return service.read(request.queryParam("path").orElse(null))
+            .flatMap(value -> ServerResponse.ok().contentType(MediaType.APPLICATION_JSON)
+                .cacheControl(CacheControl.noStore()).bodyValue(value))
+            .onErrorResume(ResponseStatusException.class, error -> {
+                var response = ServerResponse.status(error.getStatusCode())
+                    .cacheControl(CacheControl.noStore());
+                if (error.getStatusCode().value() == 429) response.header("Retry-After", "60");
+                return response.bodyValue(Map.of("error", "Statistics unavailable"));
+            });
+    }
+
+    @Override public GroupVersion groupVersion() {
+        return GroupVersion.parseAPIVersion("api.umami.halo.run/v1alpha1");
+    }
+}
diff --git a/src/main/java/run/halo/umami/PublicStatsService.java b/src/main/java/run/halo/umami/PublicStatsService.java
new file mode 100644
index 0000000..6e8d390
--- /dev/null
+++ b/src/main/java/run/halo/umami/PublicStatsService.java
@@ -0,0 +1,190 @@
+package run.halo.umami;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.core.JsonProcessingException;
+import java.net.URI;
+import java.time.Clock;
+import java.time.Duration;
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.Map;
+import java.util.UUID;
+import java.util.function.Supplier;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Component;
+import org.springframework.web.reactive.function.client.WebClient;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.web.util.UriComponentsBuilder;
+import reactor.core.publisher.Mono;
+import run.halo.app.plugin.ReactiveSettingFetcher;
+
+/** Public aggregate adapter for self-hosted Umami 3.4.0, not an arbitrary API proxy. */
+@Component
+public class PublicStatsService {
+    private static final ObjectMapper JSON = new ObjectMapper()
+        .enable(com.fasterxml.jackson.databind.DeserializationFeature.FAIL_ON_TRAILING_TOKENS);
+    private static final long MAX_SAFE_INTEGER = 9_007_199_254_740_991L;
+    private final ReactiveSettingFetcher settings;
+    private final WebClient client;
+    private final Supplier<String> token;
+    private final Clock clock;
+    private final Map<String, Entry> cache = new LinkedHashMap<>();
+    private Config currentConfig;
+    private long windowStart;
+    private int upstreamRequests;
+
+    @org.springframework.beans.factory.annotation.Autowired
+    public PublicStatsService(ReactiveSettingFetcher settings) {
+        this(settings, WebClient.builder().codecs(c -> c.defaultCodecs()
+            .maxInMemorySize(16 * 1024)).build(),
+            () -> System.getenv("HALO_UMAMI_STATS_API_KEY"), Clock.systemUTC());
+    }
+
+    PublicStatsService(ReactiveSettingFetcher settings, WebClient client,
+                       Supplier<String> token, Clock clock) {
+        this.settings = settings;
+        this.client = client;
+        this.token = token;
+        this.clock = clock;
+    }
+
+    public Mono<Map<String, Long>> read(String path) {
+        return Mono.defer(() -> {
+            if (path != null) validatePath(path);
+            return BasicProp.fetch(settings)
+                .switchIfEmpty(Mono.error(unavailable()))
+                .flatMap(prop -> {
+                    if (!prop.isPublicStatsEnabled()) {
+                        return Mono.error(new ResponseStatusException(HttpStatus.NOT_FOUND));
+                    }
+                    Config config;
+                    try {
+                        config = config(prop);
+                    } catch (RuntimeException error) {
+                        return Mono.error(unavailable());
+                    }
+                    long endAt = clock.millis();
+                    Mono<Counts> site = stats(config, null, endAt);
+                    if (path == null) {
+                        return site.map(value -> Map.of("site_uv", value.visitors(),
+                            "site_pv", value.pageviews()));
+                    }
+                    return Mono.zip(site, stats(config, path, endAt)).map(pair -> Map.of(
+                        "site_uv", pair.getT1().visitors(), "site_pv", pair.getT1().pageviews(),
+                        "page_pv", pair.getT2().pageviews()));
+                });
+        });
+    }
+
+    static void validatePath(String path) {
+        // Umami eq filters split commas; reject them rather than query multiple pages.
+        try {
+            if (path.isEmpty() || path.length() > 1024 || !path.startsWith("/")
+                || path.startsWith("//") || path.chars().anyMatch(Character::isISOControl)
+                || path.contains("\\") || path.contains("?") || path.contains("#")
+                || path.contains(",") || hasDotSegment(path)
+                || !URI.create(path).normalize().toString().equals(path)) {
+                throw new IllegalArgumentException("Invalid path");
+            }
+        } catch (IllegalArgumentException error) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid path");
+        }
+    }
+
+    private static boolean hasDotSegment(String path) {
+        // URI.normalize retains leading /../; reject it explicitly. Only recognize
+        // encoded dots here, never decode other percent bytes or rewrite stored paths.
+        for (String segment : path.split("/", -1)) {
+            String dots = segment.replaceAll("(?i)%2e", ".");
+            if (dots.equals(".") || dots.equals("..")) return true;
+        }
+        return false;
+    }
+
+    private Config config(BasicProp prop) {
+        URI endpoint = URI.create(prop.getEndpoint());
+        boolean loopback = "localhost".equals(endpoint.getHost())
+            || "127.0.0.1".equals(endpoint.getHost()) || "[::1]".equals(endpoint.getHost());
+        if (!("https".equals(endpoint.getScheme())
+            || ("http".equals(endpoint.getScheme()) && loopback))
+            || endpoint.getHost() == null || endpoint.getUserInfo() != null
+            || endpoint.getQuery() != null || endpoint.getFragment() != null) {
+            throw new IllegalArgumentException("Invalid endpoint");
+        }
+        String key = token.get();
+        if (key == null || key.isBlank() || key.contains("\r") || key.contains("\n")) {
+            throw new IllegalArgumentException("Missing API key");
+        }
+        String website = UUID.fromString(prop.getWebsiteId()).toString();
+        long start = Instant.parse(prop.getStatsStartAt()).toEpochMilli();
+        if (start < 0 || start > clock.millis()) throw new IllegalArgumentException("Invalid start");
+        return new Config(endpoint.toString().replaceAll("/+$", ""), website, start, key);
+    }
+
+    private synchronized Mono<Counts> stats(Config config, String path, long now) {
+        if (!config.equals(currentConfig)) {
+            cache.clear();
+            currentConfig = config;
+        }
+        String key = path == null ? "" : path;
+        cache.entrySet().removeIf(entry -> entry.getValue().expires() <= now);
+        Entry existing = cache.get(key);
+        if (existing != null) return existing.value();
+        if (now - windowStart >= 60_000 || now < windowStart) {
+            windowStart = now;
+            upstreamRequests = 0;
+        }
+        if (upstreamRequests >= 60) {
+            return Mono.error(new ResponseStatusException(HttpStatus.TOO_MANY_REQUESTS));
+        }
+        upstreamRequests++;
+        var uri = UriComponentsBuilder.fromUriString(config.endpoint())
+            .path("/api/websites/{website}/stats")
+            .queryParam("startAt", config.startAt()).queryParam("endAt", now);
+        if (path != null) uri.queryParam("path", "{path}");
+        Map<String, String> variables = path == null ? Map.of("website", config.website())
+            : Map.of("website", config.website(), "path", "eq." + path);
+        URI requestUri = uri.encode().buildAndExpand(variables).toUri();
+        Mono<Counts> request = client.get().uri(requestUri)
+            .headers(headers -> headers.setBearerAuth(config.token()))
+            .retrieve().onStatus(status -> !status.is2xxSuccessful(), response -> Mono.error(unavailable()))
+            .bodyToMono(String.class)
+            .switchIfEmpty(Mono.error(unavailable()))
+            .map(body -> {
+                try {
+                    // Halo 2.27 ships Jackson 2 alongside Spring's Jackson 3 codecs.
+                    // Decode explicitly so codec auto-selection cannot reinterpret JsonNode.
+                    JsonNode value = JSON.readTree(body);
+                    return new Counts(count(value, "visitors"), count(value, "pageviews"));
+                } catch (JsonProcessingException error) {
+                    throw unavailable();
+                }
+            })
+            .timeout(Duration.ofSeconds(3))
+            // Never return upstream bodies, URLs, credential errors or a fabricated zero.
+            .onErrorMap(error -> unavailable()).cache();
+        if (cache.size() >= 256) cache.remove(cache.keySet().iterator().next());
+        cache.put(key, new Entry(now + 60_000, request));
+        return request;
+    }
+
+    static long count(JsonNode value, String name) {
+        JsonNode count = value.get(name);
+        if (count == null || !count.isIntegralNumber() || !count.canConvertToLong()
+            || count.longValue() < 0 || count.longValue() > MAX_SAFE_INTEGER) {
+            throw unavailable();
+        }
+        return count.longValue();
+    }
+
+    private static ResponseStatusException unavailable() {
+        return new ResponseStatusException(HttpStatus.SERVICE_UNAVAILABLE, "Statistics unavailable");
+    }
+
+    private record Config(String endpoint, String website, long startAt, String token) {
+        @Override public String toString() { return "UmamiStatsConfig[redacted]"; }
+    }
+    private record Counts(long visitors, long pageviews) { }
+    private record Entry(long expires, Mono<Counts> value) { }
+}
