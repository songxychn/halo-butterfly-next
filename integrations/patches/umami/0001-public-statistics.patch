diff --git a/src/test/java/run/halo/umami/PublicStatsTest.java b/src/test/java/run/halo/umami/PublicStatsTest.java
new file mode 100644
index 0000000..417e814
--- /dev/null
+++ b/src/test/java/run/halo/umami/PublicStatsTest.java
@@ -0,0 +1,188 @@
+package run.halo.umami;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.time.Clock;
+import java.time.Instant;
+import java.time.ZoneId;
+import java.time.ZoneOffset;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.http.HttpStatus;
+import org.springframework.test.web.reactive.server.WebTestClient;
+import org.springframework.web.reactive.function.client.ClientRequest;
+import org.springframework.web.reactive.function.client.ClientResponse;
+import org.springframework.web.reactive.function.client.WebClient;
+import org.springframework.web.server.ResponseStatusException;
+import reactor.core.publisher.Mono;
+import run.halo.app.plugin.ReactiveSettingFetcher;
+
+class PublicStatsTest {
+    BasicProp prop;
+    ReactiveSettingFetcher settings;
+    List<ClientRequest> requests;
+    PublicStatsService service;
+    MutableClock clock;
+
+    @BeforeEach void setup() {
+        prop = new BasicProp();
+        prop.setEndpoint("https://stats.example.com");
+        prop.setWebsiteId("123e4567-e89b-12d3-a456-426614174000");
+        prop.setPublicStatsEnabled(true);
+        prop.setStatsStartAt("2026-01-01T00:00:00Z");
+        settings = mock(ReactiveSettingFetcher.class);
+        when(settings.fetch("basic", BasicProp.class)).thenReturn(Mono.just(prop));
+        requests = new ArrayList<>();
+        clock = new MutableClock();
+        service = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request -> {
+            requests.add(request);
+            return Mono.just(json("{\"visitors\":12,\"pageviews\":34,\"comparison\":{}}"));
+        }).build(), () -> "server-only-secret", clock);
+    }
+
+    @Test void mapsCountsUsesFixedTargetAndCachesSiteAcrossPages() {
+        assertThat(service.read("/archives/one/").block()).isEqualTo(
+            Map.of("site_uv", 12L, "site_pv", 34L, "page_pv", 34L));
+        service.read("/archives/one/").block();
+        service.read("/archives/two/").block();
+        assertThat(requests).hasSize(3);
+        assertThat(requests.get(0).headers().getFirst("Authorization")).isEqualTo("Bearer server-only-secret");
+        assertThat(requests.get(1).url().toString()).contains(
+            "https://stats.example.com/api/websites/123e4567-e89b-12d3-a456-426614174000/stats?",
+            "startAt=1767225600000", "endAt=1792022400000", "path=eq.%2Farchives%2Fone%2F");
+        assertThat(service.read(null).block()).containsOnlyKeys("site_uv", "site_pv");
+    }
+
+    @ParameterizedTest @ValueSource(strings = {"", "https://evil.test/a", "//evil", "/a?b", "/a#b",
+        "/a,b", "/a/../b", "/a\\b", "/a\nb", "/a b", "/%ZZ", "/../a", "/./a", "/..", "/.",
+        "/%2e%2e/a", "/.%2E/a", "/%2e./a", "/%2E/a"})
+    void rejectsNonCanonicalOrMultiPathFilters(String path) {
+        assertThatThrownBy(() -> service.read(path).block())
+            .isInstanceOf(ResponseStatusException.class).hasMessageContaining("400");
+        assertThat(requests).isEmpty();
+    }
+
+    @Test void encodingDoesNotTurnPathIntoAnotherQuery() {
+        service.read("/a&websiteId=other/").block();
+        assertThat(requests.get(1).url().toString()).contains("path=eq.%2Fa%26websiteId%3Dother%2F");
+    }
+
+    @Test void defaultOffAndMissingTokenNeverCallUpstream() {
+        prop.setPublicStatsEnabled(false);
+        assertThatThrownBy(() -> service.read(null).block()).hasMessageContaining("404");
+        prop.setPublicStatsEnabled(true);
+        var emptyToken = new PublicStatsService(settings, WebClient.create(), () -> "", clock);
+        assertThatThrownBy(() -> emptyToken.read(null).block()).hasMessageContaining("503");
+        assertThat(requests).isEmpty();
+    }
+
+    @Test void configurationChangeInvalidatesCache() {
+        service.read(null).block();
+        prop.setWebsiteId("123e4567-e89b-12d3-a456-426614174001");
+        service.read(null).block();
+        assertThat(requests).hasSize(2);
+    }
+
+    @Test void ttlAndRateLimitBoundArbitraryPaths() {
+        service.read(null).block();
+        for (int i = 0; i < 59; i++) service.read("/" + i).block();
+        assertThatThrownBy(() -> service.read("/overflow").block()).hasMessageContaining("429");
+        assertThat(requests).hasSize(60);
+        clock.now += 60_001;
+        service.read(null).block();
+        assertThat(requests).hasSize(61);
+    }
+
+    @ParameterizedTest @ValueSource(strings = {"{}", "{\"visitors\":-1,\"pageviews\":1}",
+        "{\"visitors\":1,\"pageviews\":9007199254740992}",
+        "{\"visitors\":1,\"pageviews\":1.5}", "{\"visitors\":\"1\",\"pageviews\":1}"})
+    void malformedCountsFailRatherThanBecomeZero(String body) {
+        var invalid = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request ->
+            Mono.just(json(body))).build(), () -> "secret", clock);
+        assertThatThrownBy(() -> invalid.read(null).block()).hasMessageContaining("503");
+    }
+
+    @Test void failuresAreCachedAndDoNotExposeUpstreamSecrets() {
+        AtomicInteger count = new AtomicInteger();
+        var failed = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request -> {
+            count.incrementAndGet();
+            return Mono.just(ClientResponse.create(HttpStatus.UNAUTHORIZED).body("private-secret").build());
+        }).build(), () -> "secret", clock);
+        var http = WebTestClient.bindToRouterFunction(new PublicStatsEndpoint(failed).endpoint()).build();
+        for (int i = 0; i < 2; i++) http.get().uri("/stats").exchange().expectStatus().isEqualTo(503)
+            .expectBody().json("{\"error\":\"Statistics unavailable\"}");
+        assertThat(count.get()).isEqualTo(1);
+    }
+
+    @Test void endpointRejectsUnknownOrRepeatedQueriesAndNeverReturnsCredentials() {
+        var http = WebTestClient.bindToRouterFunction(new PublicStatsEndpoint(service).endpoint()).build();
+        http.get().uri("/stats?websiteId=other").exchange().expectStatus().isBadRequest();
+        http.get().uri("/stats?path=/a&path=/b").exchange().expectStatus().isBadRequest();
+        http.get().uri("/stats?path=/post/").exchange().expectStatus().isOk()
+            .expectHeader().valueEquals("Cache-Control", "no-store")
+            .expectBody().json("{\"site_uv\":12,\"site_pv\":34,\"page_pv\":34}");
+    }
+
+    @Test void concurrentSubscribersShareUpstreamRequest() {
+        AtomicInteger count = new AtomicInteger();
+        var slow = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request -> {
+            count.incrementAndGet();
+            return Mono.delay(java.time.Duration.ofMillis(50)).map(ignored -> json("{\"visitors\":1,\"pageviews\":2}"));
+        }).build(), () -> "secret", clock);
+        Mono.zip(slow.read("/post"), slow.read("/post")).block();
+        assertThat(count.get()).isEqualTo(2);
+    }
+
+    @Test void upstreamTimeoutReturnsGenericFailureWithinThemeDeadline() {
+        var stalled = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request ->
+            Mono.never()).build(), () -> "secret", clock);
+        long started = System.nanoTime();
+        assertThatThrownBy(() -> stalled.read(null).block()).hasMessageContaining("503");
+        assertThat(java.time.Duration.ofNanos(System.nanoTime() - started).toMillis()).isLessThan(4500);
+    }
+
+    @ParameterizedTest @ValueSource(strings = {"http://private.example.com", "https://user:pass@example.com",
+        "https://example.com?token=secret", "https://example.com#fragment", "file:///tmp/key"})
+    void invalidAdminEndpointNeverReceivesCredential(String endpoint) {
+        prop.setEndpoint(endpoint);
+        assertThatThrownBy(() -> service.read(null).block()).hasMessageContaining("503");
+        assertThat(requests).isEmpty();
+    }
+
+    @Test void nonSuccessRedirectResponseIsNotAcceptedAsStatistics() {
+        var redirected = new PublicStatsService(settings, WebClient.builder().exchangeFunction(request ->
+            Mono.just(ClientResponse.create(HttpStatus.FOUND).header("Content-Type", "application/json")
+                .header("Location", "https://other.example.com")
+                .body("{\"visitors\":1,\"pageviews\":2}").build())).build(), () -> "secret", clock);
+        assertThatThrownBy(() -> redirected.read(null).block()).hasMessageContaining("503");
+    }
+
+    @Test void endpointRejectsDecodedLeadingTraversalWithoutRewritingLegitimatePercentPaths() {
+        var http = WebTestClient.bindToRouterFunction(new PublicStatsEndpoint(service).endpoint()).build();
+        http.get().uri(java.net.URI.create("/stats?path=/%2e%2e/a")).exchange()
+            .expectStatus().isBadRequest();
+        assertThat(requests).isEmpty();
+        service.read("/archives/%E4%BD%A0/%25discount/%2e-report/").block();
+        assertThat(requests.get(1).url().toString()).contains(
+            "path=eq.%2Farchives%2F%25E4%25BD%25A0%2F%2525discount%2F%252e-report%2F");
+    }
+
+    private static ClientResponse json(String body) {
+        return ClientResponse.create(HttpStatus.OK).header("Content-Type", "application/json").body(body).build();
+    }
+    static class MutableClock extends Clock {
+        long now = Instant.parse("2026-10-15T00:00:00Z").toEpochMilli();
+        public ZoneId getZone() { return ZoneOffset.UTC; }
+        public Clock withZone(ZoneId zone) { return this; }
+        public Instant instant() { return Instant.ofEpochMilli(now); }
+    }
+}
