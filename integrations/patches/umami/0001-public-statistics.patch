@@ -0,0 +1,92 @@
+package run.halo.umami;
+
+import static org.mockito.Mockito.*;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.NullAndEmptySource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.thymeleaf.context.ITemplateContext;
+import org.thymeleaf.model.IModel;
+import org.thymeleaf.model.IModelFactory;
+import org.thymeleaf.model.IText;
+import org.thymeleaf.processor.element.IElementModelStructureHandler;
+import reactor.core.publisher.Mono;
+import run.halo.app.plugin.ReactiveSettingFetcher;
+
+class UmamiTrackerProcessorTest {
+    @Test void themeOwnedTrackingAvoidsDuplicateScript() {
+        var prop = configuredProp();
+        prop.setDisableTracker(true);
+        var settings = mock(ReactiveSettingFetcher.class);
+        when(settings.fetch("basic", BasicProp.class)).thenReturn(Mono.just(prop));
+        var context = mock(ITemplateContext.class);
+        var model = mock(IModel.class);
+        new UmamiTrackerProcessor(settings).process(context, model,
+            mock(IElementModelStructureHandler.class)).block();
+        verifyNoInteractions(context, model);
+    }
+
+    @Test void pluginOwnedTrackingStillWorksByDefault() {
+        var prop = new BasicProp();
+        prop.setWebsiteId("test-id");
+        prop.setEndpoint("https://stats.example.com");
+        prop.setScriptName("script.js");
+        var settings = mock(ReactiveSettingFetcher.class);
+        when(settings.fetch("basic", BasicProp.class)).thenReturn(Mono.just(prop));
+        var context = mock(ITemplateContext.class);
+        var factory = mock(IModelFactory.class);
+        when(context.getModelFactory()).thenReturn(factory);
+        var text = mock(IText.class);
+        when(factory.createText(anyString())).thenReturn(text);
+        var model = mock(IModel.class);
+        new UmamiTrackerProcessor(settings).process(context, model,
+            mock(IElementModelStructureHandler.class)).block();
+        verify(factory).createText(contains("https://stats.example.com/script.js"));
+        verify(model).add(text);
+    }
+
+    @ParameterizedTest @NullAndEmptySource @ValueSource(strings = {"  "})
+    void missingEndpointDoesNotInjectInvalidRelativeScript(String endpoint) {
+        var prop = configuredProp();
+        prop.setEndpoint(endpoint);
+        assertNoTracker(Mono.just(prop));
+    }
+
+    @ParameterizedTest @NullAndEmptySource @ValueSource(strings = {"  "})
+    void missingWebsiteIdDoesNotInjectTracker(String websiteId) {
+        var prop = configuredProp();
+        prop.setWebsiteId(websiteId);
+        assertNoTracker(Mono.just(prop));
+    }
+
+    @ParameterizedTest @NullAndEmptySource @ValueSource(strings = {"  "})
+    void missingScriptNameDoesNotInjectInvalidScript(String scriptName) {
+        var prop = configuredProp();
+        prop.setScriptName(scriptName);
+        assertNoTracker(Mono.just(prop));
+    }
+
+    @Test void missingSettingsGroupDoesNotInjectTracker() {
+        assertNoTracker(Mono.empty());
+    }
+
+    private static BasicProp configuredProp() {
+        var prop = new BasicProp();
+        prop.setWebsiteId("test-id");
+        prop.setEndpoint("https://stats.example.com");
+        prop.setScriptName("script.js");
+        return prop;
+    }
+
+    private static void assertNoTracker(Mono<BasicProp> prop) {
+        var settings = mock(ReactiveSettingFetcher.class);
+        when(settings.fetch("basic", BasicProp.class)).thenReturn(prop);
+        var context = mock(ITemplateContext.class);
+        var model = mock(IModel.class);
+        new UmamiTrackerProcessor(settings).process(context, model,
+            mock(IElementModelStructureHandler.class)).block();
+        verifyNoInteractions(context, model);
+    }
+
+}
