@@ -0,0 +1,42 @@
+package run.halo.comment.widget;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.mockito.Mockito.*;
+
+import org.junit.jupiter.api.Test;
+import org.thymeleaf.context.ITemplateContext;
+import org.thymeleaf.model.IModel;
+import org.thymeleaf.model.IModelFactory;
+import org.thymeleaf.processor.element.IElementModelStructureHandler;
+import run.halo.app.plugin.PluginContext;
+
+class CommentWidgetHeadProcessorTest {
+    @Test
+    void managedContractHasVersionedMetadataButNoDownloadTags() {
+        var plugin = mock(PluginContext.class);
+        when(plugin.getVersion()).thenReturn("3.4.0-theme-demand.1");
+        var processor = new CommentWidgetHeadProcessor(plugin);
+        var result = processor.commentWidgetScript(true);
+        assertThat(result).contains("halo-comment-widget-contract", "content=\"1\"",
+            "halo-comment-widget-module", "halo-comment-widget-style",
+            "version=3.4.0-theme-demand.1").doesNotContain("<link", "<script");
+        assertThat(processor.commentWidgetScript(false)).contains("rel=\"modulepreload\"",
+            "rel=\"stylesheet\"").doesNotContain("halo-comment-widget-contract");
+    }
+
+    @Test
+    void onlyExplicitBooleanOptInChangesTheCurrentRequest() {
+        var plugin = mock(PluginContext.class);
+        when(plugin.getVersion()).thenReturn("3.4.0-theme-demand.1");
+        var processor = new CommentWidgetHeadProcessor(plugin);
+        for (Object marker : new Object[]{null, false, "true", true}) {
+            var context = mock(ITemplateContext.class);
+            var factory = mock(IModelFactory.class);
+            when(context.getModelFactory()).thenReturn(factory);
+            when(context.getVariable("haloCommentResourcesManaged")).thenReturn(marker);
+            processor.process(context, mock(IModel.class),
+                mock(IElementModelStructureHandler.class)).block();
+            verify(factory).createText(processor.commentWidgetScript(Boolean.TRUE.equals(marker)));
+        }
+    }
+}
