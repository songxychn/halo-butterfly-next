@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import {readFileSync} from 'node:fs';
+const loader = readFileSync(new URL('../src/main/resources/frontend/on-demand.js', import.meta.url),'utf8');
+for (const failure of ['error','timeout']) {
+  const elements=[],handlers={},timers=[];
+  let currentNodes=[];
+  const config={css:'/katex.css',js:'/katex.js',frontend:true,inline:'.math-inline',display:'.math-display'};
+  const makeNode=()=>({isConnected:true,matches:()=>false,querySelector:()=>null,closest:()=>null,getAttribute:()=>null,textContent:'x'});
+  const document={readyState:'complete',body:{querySelectorAll:s=>s==='.math-inline'?currentNodes:[],querySelector:()=>null},head:{append:el=>{el.isConnected=true;elements.push(el)}},createElement:tag=>({tag,dataset:{},isConnected:false,remove(){this.isConnected=false}}),addEventListener:(name,fn)=>handlers[name]=fn,dispatchEvent:()=>{}};
+  const window={katex:{render(){}}};
+  vm.runInNewContext(loader.replace('/* HALO_KATEX_CONFIG */',JSON.stringify(config)),{window,document,CustomEvent:class{},setTimeout:fn=>{timers.push(fn);return timers.length;},clearTimeout(){}});
+  const oldNode=makeNode();currentNodes=[oldNode];const first=window.haloKatexDemand.refresh();
+  handlers['katex:suspend']();elements[0].isConnected=false;oldNode.isConnected=false;
+  currentNodes=[makeNode()];window.haloKatexDemand.configure(config);const second=window.haloKatexDemand.refresh();
+  assert.equal(elements.filter(x=>x.tag==='link'&&x.isConnected).length,1);
+  if (failure==='error') elements[0].onerror(); else timers[0]();
+  await Promise.resolve();elements[1].onload();await Promise.resolve();await Promise.resolve();
+  elements.find(x=>x.tag==='script').onload();await first;await second;
+  currentNodes=[makeNode()];await window.haloKatexDemand.refresh();
+  assert.equal(elements.filter(x=>x.tag==='link'&&x.isConnected).length,1,`stale ${failure} must not invalidate the replacement resource`);
+  console.log(`late CSS ${failure}: passed`);
+}
diff --git a/tests/on-demand.browser.mjs b/tests/on-demand.browser.mjs
new file mode 100644
index 0000000..c912938
--- /dev/null
+++ b/tests/on-demand.browser.mjs
@@ -0,0 +1,139 @@
+// Run with PLAYWRIGHT_MODULE=/absolute/path/to/playwright/index.mjs node tests/on-demand.browser.mjs.
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+import {createServer} from 'node:http';
+const pw = await import(process.env.PLAYWRIGHT_MODULE || 'playwright');
+const loader = await readFile(new URL('../src/main/resources/frontend/on-demand.js', import.meta.url), 'utf8');
+const root = new URL('../src/main/resources/static/', import.meta.url);
+const requests = [];
+const failures = new Set();
+const server = createServer(async (req, res) => {
+  const url = new URL(req.url, 'http://local');
+  requests.push(url.pathname);
+  if (failures.delete(url.pathname)) { res.writeHead(503); res.end('retry'); return; }
+  if (url.pathname.startsWith('/static/')) {
+    try {
+      const path = url.pathname.slice(8);
+      if (path.includes('..')) throw Error('path');
+      res.setHeader('Content-Type', path.endsWith('.js') ? 'text/javascript; charset=utf-8' : path.endsWith('.css') ? 'text/css' : 'font/woff2');
+      res.end(await readFile(new URL(path, root)));
+    } catch { res.writeHead(404); res.end(); }
+    return;
+  }
+  res.setHeader('Content-Type', 'text/html; charset=utf-8');
+  const body = url.searchParams.get('body') || '<p>Plain content</p>';
+  const config = {css:'/static/katex.min.css', js:'/static/katex.min.js', frontend:url.searchParams.get('frontend') !== 'false', inline:url.searchParams.get('inline') ?? '.math-inline', display:'.math-display'};
+  const script = loader.replace('/* HALO_KATEX_CONFIG */', JSON.stringify(config).replaceAll('<','\\u003c'));
+  res.end(`<!DOCTYPE html><html><head><script>${script}</script></head><body>${body}</body></html>`);
+});
