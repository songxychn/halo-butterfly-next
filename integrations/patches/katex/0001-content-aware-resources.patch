diff --git a/src/main/java/run/halo/katex/KaTeXOnDemand.java b/src/main/java/run/halo/katex/KaTeXOnDemand.java
new file mode 100644
index 0000000..892480a
--- /dev/null
+++ b/src/main/java/run/halo/katex/KaTeXOnDemand.java
@@ -0,0 +1,51 @@
+package run.halo.katex;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.util.Map;
+import org.springframework.core.io.ClassPathResource;
+
+/** Inline discovery avoids a network request on pages without formulas. */
+final class KaTeXOnDemand {
+    private static final ObjectMapper JSON = new ObjectMapper();
+    private static final String LOADER = loadLoader();
+
+    private KaTeXOnDemand() {
+    }
+
+    static String head(BasicConfig config, String version) {
+        var base = "/plugins/plugin-katex/assets/static/";
+        var suffix = "?version=" + version;
+        var options = Map.of(
+            "css", base + "katex.min.css" + suffix,
+            "js", base + "katex.min.js" + suffix,
+            "frontend", config.isEnable_frontend_katex(),
+            "inline", config.getInline_selector() == null ? ".math-inline" : config.getInline_selector(),
+            "display", config.getDisplay_selector() == null ? ".math-display" : config.getDisplay_selector()
+        );
+        return "<script data-katex-demand=\"1\" data-katex-version=\""
+            + org.springframework.web.util.HtmlUtils.htmlEscape(version) + "\">\n"
+            + LOADER.replace("/* HALO_KATEX_CONFIG */", scriptJson(options)) + "\n</script>";
+    }
+
+    static String scriptJson(Object value) {
+        try {
+            // HTML raw-text script parsing happens before JavaScript parsing.
+            return JSON.writeValueAsString(value).replace("<", "\\u003c")
+                .replace(">", "\\u003e").replace("&", "\\u0026")
+                .replace("\u2028", "\\u2028").replace("\u2029", "\\u2029");
+        } catch (JsonProcessingException e) {
+            throw new IllegalArgumentException("Cannot serialize KaTeX configuration", e);
+        }
+    }
+
+    static String loadLoader() {
+        try (var stream = new ClassPathResource("frontend/on-demand.js", KaTeXOnDemand.class.getClassLoader()).getInputStream()) {
+            return new String(stream.readAllBytes(), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            throw new IllegalStateException("Missing KaTeX content loader", e);
+        }
+    }
+}
