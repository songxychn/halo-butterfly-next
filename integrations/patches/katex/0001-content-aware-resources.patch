diff --git a/src/test/java/run/halo/katex/KaTeXOnDemandTest.java b/src/test/java/run/halo/katex/KaTeXOnDemandTest.java
new file mode 100644
index 0000000..d536e3c
--- /dev/null
+++ b/src/test/java/run/halo/katex/KaTeXOnDemandTest.java
@@ -0,0 +1,49 @@
+package run.halo.katex;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class KaTeXOnDemandTest {
+    @Test
+    void pluginResourceDoesNotUseTheHostThreadContextClassLoader() throws Exception {
+        var thread = Thread.currentThread();
+        var original = thread.getContextClassLoader();
+        try (var isolatedHost = new java.net.URLClassLoader(new java.net.URL[0], null)) {
+            thread.setContextClassLoader(isolatedHost);
+            assertThat(isolatedHost.getResource("frontend/on-demand.js")).isNull();
+            assertThat(KaTeXOnDemand.loadLoader()).startsWith("/* halo-katex-demand:v1 */");
+            assertThat(KaTeXOnDemand.head(new BasicConfig(), "3.0.0-demand.1"))
+                .contains("data-katex-demand=\"1\"");
+        } finally {
+            thread.setContextClassLoader(original);
+        }
+    }
+
+    @Test
+    void optInIsExplicit() {
+        var config = new BasicConfig();
+        assertThat(config.isOnDemand()).isFalse();
+        config.setResource_loading("on_demand");
+        assertThat(config.isOnDemand()).isTrue();
+    }
+
+    @Test
+    void metadataDoesNotStartAnyResourceDownload() {
+        var config = new BasicConfig();
+        var head = KaTeXOnDemand.head(config, "3.0.0-demand.1");
+        assertThat(head).startsWith("<script data-katex-demand=\"1\" data-katex-version=\"3.0.0-demand.1\">")
+            .doesNotContain("<link", "<script src=", "/* HALO_KATEX_CONFIG */")
+            .contains("\"frontend\":false", "katex.min.css?version=3.0.0-demand.1");
+    }
+
+    @Test
+    void selectorsAreJsonSerializedAndCannotEndTheScriptElement() {
+        var config = new BasicConfig();
+        config.setInline_selector("</script><script>alert('x')</script>\\\"\n");
+        var head = KaTeXOnDemand.head(config, "3.0.0-demand.1");
+        assertThat(head).doesNotContain("</script><script>", "<script>alert")
+            .contains("\\u003c/script\\u003e", "\\n");
+        assertThat(head.split("</script>", -1)).hasSize(2);
+    }
+}
