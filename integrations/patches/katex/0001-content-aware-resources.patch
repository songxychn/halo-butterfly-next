diff --git a/src/main/resources/frontend/on-demand.js b/src/main/resources/frontend/on-demand.js
new file mode 100644
index 0000000..7a86025
--- /dev/null
+++ b/src/main/resources/frontend/on-demand.js
@@ -0,0 +1,99 @@
+/* halo-katex-demand:v1 */
+(function (config) {
+  'use strict';
+  // One owner per document, including PJAX navigations and repeated initialization.
+  if (window.haloKatexDemand) {
+    window.haloKatexDemand.configure(config);
+    window.haloKatexDemand.refresh();
+    return;
+  }
+  let active = true;
+  const resources = new Map();
+  const elements = new Map();
+  const rendered = new WeakSet();
+  const pending = new WeakSet();
+  const existing = 'math,.katex,.katex-error';
+  function load(url, style) {
+    if (resources.has(url)) {
+      // Head replacement removes CSS, while the loaded renderer remains in this window.
+      if (!style || elements.get(url)?.isConnected) return resources.get(url);
+      resources.delete(url);
+      elements.delete(url);
+    }
+    const promise = new Promise((resolve, reject) => {
+      const element = document.createElement(style ? 'link' : 'script');
+      if (style) { element.rel = 'stylesheet'; element.href = url; }
+      else { element.src = url; element.async = true; element.dataset.katexDemandResource = '1'; }
+      const timer = setTimeout(() => fail(), 15000);
+      function fail() {
+        clearTimeout(timer);
+        element.onload = element.onerror = null;
+        element.remove();
+        // A removed page may fail after its replacement started the same URL.
+        if (elements.get(url) === element) {
+          resources.delete(url);
+          elements.delete(url);
+        }
+        reject(new Error('KaTeX resource unavailable'));
+      }
+      element.onload = () => { clearTimeout(timer); element.onload = element.onerror = null; resolve(); };
+      element.onerror = fail;
+      elements.set(url, element);
+      document.head.append(element);
+    });
+    resources.set(url, promise);
+    return promise;
+  }
+  function select(selector) {
+    if (!selector || !selector.trim()) return [];
+    try { return Array.from(document.body.querySelectorAll(selector)); }
+    catch { return []; } // Invalid administrator selectors never break page initialization.
+  }
+  function raw(node) {
+    return !rendered.has(node) && !pending.has(node)
+      && !node.matches(existing) && !node.querySelector(existing)
+      && !node.closest('pre,code,.katex,math,.theme-math-source');
+  }
+  async function refresh() {
+    if (!active || !document.body) return;
+    const settings = config;
+    const candidates = new Map();
+    if (settings.frontend) {
+      for (const node of select(settings.inline)) if (raw(node)) candidates.set(node, false);
+      for (const node of select(settings.display)) if (raw(node)) candidates.set(node, true);
+    }
+    if (!document.body.querySelector(existing) && candidates.size === 0) return;
+    const nodes = Array.from(candidates);
+    for (const [node] of nodes) pending.add(node);
+    try {
+      await load(settings.css, true);
+      if (!active || !nodes.some(([node]) => node.isConnected)) return;
+      await load(settings.js, false);
+      if (!window.katex || typeof window.katex.render !== 'function') {
+        resources.delete(settings.js);
+        elements.get(settings.js)?.remove();
+        elements.delete(settings.js);
+        throw new Error('KaTeX renderer unavailable');
+      }
+      for (const [node, displayMode] of nodes) {
+        // Navigation may have detached this page while resources were downloading.
+        if (!active || !node.isConnected || node.matches(existing) || node.querySelector(existing)) continue;
+        const source = node.getAttribute('content') ?? node.textContent ?? '';
+        try {
+          window.katex.render(source, node, { displayMode, throwOnError: false, trust: false });
+          rendered.add(node);
+        } catch { /* Keep readable source; another refresh may retry. */ }
+      }
+    } catch {
+      document.dispatchEvent(new CustomEvent('katex:resource-error'));
+    } finally {
+      for (const [node] of nodes) pending.delete(node);
+    }
+  }
+  window.haloKatexDemand = { refresh, configure(next) { config = next; active = true; } };
+  document.addEventListener('katex:suspend', () => { active = false; });
+  document.addEventListener('pjax:complete', refresh);
+  document.addEventListener('katex:refresh', refresh);
+  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', refresh, { once: true });
+  else void refresh();
+})(/* HALO_KATEX_CONFIG */);
