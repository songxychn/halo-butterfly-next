{
  "name": "halo-butterfly-next",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "Butterfly 的 Halo 社区维护版",
  "license": "GPL-3.0",
  "author": {
    "name": "小红",
    "url": "https://github.com/dhjddcn"
  },
  "contributors": [
    {
      "name": "Halo Butterfly Next contributors"
    }
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "dev": "bun scripts/build.mjs --watch",
    "build": "bun scripts/build.mjs",
    "check": "bun test --parallel=4 --isolate --timeout 30000 ./tests",
    "verify": "bun run typecheck && bun run check && bun run build && bun scripts/check-package.mjs",
    "lab": "python3 scripts/lab/lab.py",
    "site:check": "bun site/check.mjs",
    "migrate": "bun scripts/migrate-config.mjs",
    "typecheck": "bun run --bun tsc --noEmit",
    "site:local": "python3 -B site/local.py"
  },
  "devDependencies": {
    "@egjs/infinitegrid": "4.13.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "abcjs": "6.6.4",
    "autoprefixer": "^10.4.18",
    "chart.js": "4.5.1",
    "chokidar": "^4.0.3",
    "dompurify": "3.4.12",
    "echarts": "^5.3.2",
    "jszip": "^3.10.1",
    "marked": "18.0.14",
    "mermaid": "11.16.0",
    "pace-js": "1.2.4",
    "postcss": "^8.5.0",
    "postcss-import": "^16.1.0",
    "sass": "^1.63.6",
    "tocbot": "^4.25.0",
    "typed.js": "^2.1.0",
    "typescript": "7.0.2",
    "viewerjs": "1.14.0",
    "vite": "^7.0.0",
    "yaml": "^2.8.0"
  },
  "type": "module"
}
